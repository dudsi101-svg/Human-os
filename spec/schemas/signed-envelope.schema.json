{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signed HOSP Envelope",
  "type": "object",
  "required": [
    "envelope",
    "signature"
  ],
  "properties": {
    "envelope": {
      "type": "object",
      "required": [
        "protocol",
        "message_id",
        "sender_id",
        "recipient_id",
        "purpose",
        "expires_at",
        "nonce",
        "payload"
      ]
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "algorithm",
        "value"
      ]
    }
  }
}